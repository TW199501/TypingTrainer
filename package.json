{
  "name": "typing-trainer",
  "private": true,
  "version": "0.1.10",
  "type": "module",
  "description": "TypeLab — typing trainer for English, Chinese and code, packaged for desktop with Tauri.",
  "workspaces": [
    "apps"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @typelab/web",
    "build": "npm run build --workspace @typelab/web",
    "preview": "npm run preview --workspace @typelab/web",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,vue,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,json,md,css}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "version:show": "node scripts/version.mjs",
    "version:patch": "node scripts/version.mjs patch",
    "version:minor": "node scripts/version.mjs minor",
    "version:major": "node scripts/version.mjs major",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "api:dev": "dotnet run --project server/TypeLab.Api --launch-profile https",
    "db:schema": "node scripts/export-schema.mjs",
    "docker:up": "docker compose -f docker/docker-compose.yml up --build -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=24.18"
  }
}
