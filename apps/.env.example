# Copy to .env.local and adjust. Both flags are read at build time by Vite.

# Base URL of the ASP.NET Core API.
VITE_API_BASE_URL=https://localhost:7001/api

# true  → all data comes from the in-repo sample fixtures (no backend needed)
# false → every request goes to VITE_API_BASE_URL
VITE_USE_MOCK=true
