<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.14</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Web SDK leaves appsettings.json beside a single-file executable, but the
         sidecar ships as that executable alone. Bundling it lets self-extract put it
         next to AppContext.BaseDirectory, where the sidecar content root points. -->
    <Content Update="appsettings.json" ExcludeFromSingleFile="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ELF.Modules.Hosting.Sidecar" Version="0.8.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="SqlSugarCore" Version="5.1.4.221" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\framework\XiHan.Framework.Translation\XiHan.Framework.Translation.csproj" />
    <ProjectReference Include="..\framework\XiHan.Framework.Translation.Google\XiHan.Framework.Translation.Google.csproj" />
    <ProjectReference Include="..\framework\XiHan.Framework.Translation.OpenCC\XiHan.Framework.Translation.OpenCC.csproj" />
  </ItemGroup>

</Project>
